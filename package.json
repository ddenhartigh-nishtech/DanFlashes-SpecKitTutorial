{
  "name": "danflashes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run test:e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "db:studio": "drizzle-kit studio",
    "catalog:audit": "tsx scripts/catalog-audit.ts",
    "shirts:sweep": "tsx scripts/shirts-sweep.ts",
    "shirts:sweep:delete": "tsx scripts/shirts-sweep.ts --yes",
    "admin:grant": "tsx scripts/admin.ts grant",
    "admin:revoke": "tsx scripts/admin.ts revoke",
    "art:generate": "tsx scripts/generate-shirt-art.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "big.js": "^7.0.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/big.js": "^7.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22"
  }
}
