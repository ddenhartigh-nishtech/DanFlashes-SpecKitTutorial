{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://danflashes.local/schemas/shirt.json",
  "title": "Dan Flashes Shirt",
  "description": "One file per shirt at catalog/shirts/<slug>.json. Owner-edited. The Zod schema in src/lib/catalog/schema.ts is the runtime source of truth and must match this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "name", "style", "complexity", "description", "images"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Must equal the file name without .json" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "style": { "enum": ["polo", "button-down"] },
    "complexity": { "type": "integer", "minimum": 0, "description": "Owner-assigned. Drives the MSRP." },
    "finalPrice": { "type": "integer", "minimum": 1, "description": "Whole dollars. Optional owner override; defaults to MSRP." },
    "bland": { "type": "boolean", "default": false, "description": "Foil shirt. Final price must be under $300." },
    "description": { "type": "string", "minLength": 1, "description": "Hype copy, Dan Flashes voice." },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["src", "alt"],
        "properties": {
          "src": { "type": "string", "description": "Path under public/, e.g. /shirts/geo-riot.svg" },
          "alt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "status": { "enum": ["active", "removed"], "default": "active" },
    "featured": { "type": "boolean" }
  },
  "examples": [
    {
      "slug": "tc-tugger-belly-breather",
      "name": "T.C. Tugger Belly Breather",
      "style": "button-down",
      "complexity": 34,
      "description": "A cross-over legend. Tug it. Tug it again. Still complicated.",
      "images": [{ "src": "/shirts/tc-tugger-belly-breather.svg", "alt": "Interlocking orange zigzags over teal paisley with tug-ready fabric" }]
    }
  ]
}
