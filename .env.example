# Path to the SQLite database file. Defaults to data/danflashes.db.
DATABASE_PATH=data/danflashes.db

# Where db:backup / db:migrate / db:reset write timestamped backups. Defaults to backups/.
BACKUP_DIR=backups

# Where uploaded pictures are kept (008). Defaults to an "uploads" folder beside the database file.
# MEDIA_UPLOADS_DIR=data/uploads

# PSSB's model (012). Defaults to this machine's Ollama and llama3.2:3b; Dan's Settings override these.
# PSSB_MODEL_URL=http://localhost:11434
# PSSB_MODEL=llama3.2:3b
